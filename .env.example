# ==============================================================================
# Environment Configuration Template
# Multilingual Mass Communication & Public Awareness Management Platform
# ==============================================================================
# Note: Services load environment variables from their respective directories:
# - backend/.env
# - ai-service/.env

# --- Backend Configuration (backend/.env) ---
SECRET_KEY=django-insecure-change-this-in-production-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_multilingual_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
AI_SERVICE_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Service Configuration (ai-service/.env) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_PRIMARY_PROVIDER=groq
AI_SECONDARY_PROVIDER=gemini
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
